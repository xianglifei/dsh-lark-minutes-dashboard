{
  "name": "dsh-lark-minutes-dashboard",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "妙记工作台：自动发现飞书妙记、生成标题与完整纪要、写入飞书文档并维护索引",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
